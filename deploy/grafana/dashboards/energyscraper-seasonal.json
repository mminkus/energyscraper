{
  "uid": "energyscraper-seasonal",
  "title": "energyscraper - Seasonal",
  "tags": ["energyscraper", "solar", "powerwall"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30m",
  "time": { "from": "now-1y", "to": "now" },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Daily energy by source",
      "description": "Energy per roof orientation per day: mean power over each 24h window times 24h. Total is the metered solar figure, so the four sources should sum to roughly it.",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "energyscraper-prom" },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "min": 0,
          "custom": { "drawStyle": "line", "fillOpacity": 0, "showPoints": "never", "lineWidth": 2, "lineInterpolation": "smooth" }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "North (String 1)" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } } ] },
          { "matcher": { "id": "byName", "options": "West (String 2)" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } } ] },
          { "matcher": { "id": "byName", "options": "East (String 3)" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#c98500" } } ] },
          { "matcher": { "id": "byName", "options": "South (SMA)" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#9085e9" } } ] },
          { "matcher": { "id": "byName", "options": "Total (meter)" }, "properties": [ { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 4] } }, { "id": "custom.lineWidth", "value": 1 }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "#8E8E9E" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "avg_over_time(energyscraper_pv_string_power_watts{string=\"1\"}[24h]) * 24 / 1000", "legendFormat": "North (String 1)", "interval": "1d", "datasource": { "type": "prometheus", "uid": "energyscraper-prom" } },
        { "refId": "B", "expr": "avg_over_time(energyscraper_pv_string_power_watts{string=\"2\"}[24h]) * 24 / 1000", "legendFormat": "West (String 2)", "interval": "1d", "datasource": { "type": "prometheus", "uid": "energyscraper-prom" } },
        { "refId": "C", "expr": "avg_over_time(energyscraper_pv_string_power_watts{string=\"3\"}[24h]) * 24 / 1000", "legendFormat": "East (String 3)", "interval": "1d", "datasource": { "type": "prometheus", "uid": "energyscraper-prom" } },
        { "refId": "D", "expr": "clamp_min(avg_over_time(energyscraper_solar_ac_coupled_watts[24h]), 0) * 24 / 1000", "legendFormat": "South (SMA)", "interval": "1d", "datasource": { "type": "prometheus", "uid": "energyscraper-prom" } },
        { "refId": "E", "expr": "avg_over_time(energyscraper_solar_total_watts[24h]) * 24 / 1000", "legendFormat": "Total (meter)", "interval": "1d", "datasource": { "type": "prometheus", "uid": "energyscraper-prom" } }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Share of daily production by source",
      "description": "The same four sources stacked to 100 percent. Shows the seasonal handover as the sun moves south: the south array's share should climb through autumn and winter while east and west fall away.",
      "gridPos": { "h": 11, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "energyscraper-prom" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": { "drawStyle": "line", "fillOpacity": 70, "showPoints": "never", "lineWidth": 1, "lineInterpolation": "smooth", "stacking": { "mode": "percent", "group": "A" } }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "North (String 1)" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#3987e5" } } ] },
          { "matcher": { "id": "byName", "options": "West (String 2)" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#199e70" } } ] },
          { "matcher": { "id": "byName", "options": "East (String 3)" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#c98500" } } ] },
          { "matcher": { "id": "byName", "options": "South (SMA)" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "#9085e9" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "avg_over_time(energyscraper_pv_string_power_watts{string=\"1\"}[24h]) * 24 / 1000", "legendFormat": "North (String 1)", "interval": "1d", "datasource": { "type": "prometheus", "uid": "energyscraper-prom" } },
        { "refId": "B", "expr": "avg_over_time(energyscraper_pv_string_power_watts{string=\"2\"}[24h]) * 24 / 1000", "legendFormat": "West (String 2)", "interval": "1d", "datasource": { "type": "prometheus", "uid": "energyscraper-prom" } },
        { "refId": "C", "expr": "avg_over_time(energyscraper_pv_string_power_watts{string=\"3\"}[24h]) * 24 / 1000", "legendFormat": "East (String 3)", "interval": "1d", "datasource": { "type": "prometheus", "uid": "energyscraper-prom" } },
        { "refId": "D", "expr": "clamp_min(avg_over_time(energyscraper_solar_ac_coupled_watts[24h]), 0) * 24 / 1000", "legendFormat": "South (SMA)", "interval": "1d", "datasource": { "type": "prometheus", "uid": "energyscraper-prom" } }
      ]
    }
  ]
}
